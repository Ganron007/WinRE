# WinRE control-plane LLM config
# Copy this file to .env (same dir), fill in your values, and never commit .env.
#   cp .env.template .env
#
# The pipeline reads these via winre/envfile.py on import (env vars win over
# the file, so per-run overrides still work).

# OpenAI-compatible BASE URL (base only, e.g. http://127.0.0.1:11434).
# The client appends /chat/completions itself, ALWAYS — so a FULL
# endpoint URL does not work: it became
# https://host/v1/chat/completions/chat/completions (code audit 2026-09-28).
# Format: URL string
WINRE_LLM_BASE_URL=

# OpenAI-compatible model name (use the model name your provider exposes)
# Format: string
WINRE_LLM_MODEL=
# Optional role pins (RevAI handoff item 7). Leave blank to use
# WINRE_LLM_MODEL for that role. A pin never moves the other roles.
#   WINRE_LLM_PLANNER_MODEL = the 35-tool ReAct loop (call/token heavy)
#   WINRE_LLM_VERDICT_MODEL = the final judge (verdict + finalize pass)
#WINRE_LLM_PLANNER_MODEL=
#WINRE_LLM_VERDICT_MODEL=

# Provider-specific reasoning control. On the Agnes Chat Completions endpoint,
# use enabled or disabled; low/medium/high/max are accepted as legacy aliases
# for enabled, not as effort levels. Other providers may support effort values.
# Format: string
WINRE_LLM_REASONING=

# Optional context/output budgets. Provider-specific limits clamp these values.
# The evidence budget is estimated from the effective context window, reserving
# 30% for prompts, planner history and output.
#WINRE_LLM_CONTEXT_TOKENS=1000000
#WINRE_LLM_MAX_OUTPUT_TOKENS=32768

# Per-request HTTP timeout (seconds). Code default is 120; 600 gives slower
# Thinking-enabled endpoints room to finish before the client aborts.
WINRE_LLM_TIMEOUT=600

# API key for the above endpoint
# Format: string
WINRE_LLM_API_KEY=

# ── FlareVM (execution plane) ──────────────────────────────────────────────
# Your isolated FlareVM reachable over SSH from this control plane.
# Copy .env.template to .env and fill in YOUR lab values (never commit .env).
FLARE_HOST=
FLARE_USER=FLARE-VM
FLARE_SSH_KEY=
FLARE_SSH_PORT=22
# Flare SSH and file sync go through the REMnux gateway. Flare blocks every
# VMnet2 peer except .43, including the workstation host adapter.
WINRE_GATEWAY_HOST=192.168.77.43
WINRE_GATEWAY_USER=remnux
WINRE_GATEWAY_SSH_KEY=C:\Users\<user>\.ssh\RevAI
# Persistent FlareVM isolation policy. Flare uses .43 as its default gateway
# and DNS so all off-subnet traffic reaches the simulator/capture host. The
# REMnux gateway has forwarding disabled; listed same-subnet peers are blocked
# directly by Windows Firewall because local-subnet traffic bypasses routing.
# Only .43 can manage Flare over SSH; direct host access is blocked.
WINRE_ANALYSIS_GATEWAY=192.168.77.43
WINRE_BLOCKED_PEERS=192.168.77.41

# ── Snapshot gate (optional) ───────────────────────────────────────────────
# observe (advisory execution budget) | enforce (one execution per verified
# clean restore) | off (disable the execution budget only; pipeline trust gate remains)
# ENFORCE is the code default and the safe one: under enforce a single
# operator-verified clean restore permits exactly ONE execution, so a run
# that asks for both --dynamic and --agentic-dbg is refused before any
# stage runs. This template used to ship `observe`, which silently
# disabled that guarantee for everyone who followed docs/INSTALL.md
# (code audit 2026-09-28).
WINRE_SNAPSHOT_GATE=enforce
# Evidence root: where packs (and their reports) are written. Leave unset
# and it is <this repo>/logs on whichever machine runs the pipeline -
# C:\WinRE\logs on the FlareVM, <checkout>\logs on the operator host - so
# the CLI and the web console always agree with no configuration. Always
# gitignored. Set it only to keep packs somewhere else.
#WINRE_PIPELINE_LOGS=

# Snapshot restore is an OPERATOR action and is deliberately NOT a WinRE
# feature: WinRE never reverts your VM. Reverting re-arms the one-shot
# clean marker, which would let a single run execute the sample repeatedly
# with nobody deciding the VM was clean again. Restore the snapshot
# yourself between runs - that is exactly what the marker is for.

# VirusTotal HASH-ONLY triage (control plane; only the SHA256 is sent)
WINRE_VT_API_KEY=
