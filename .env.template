# WinRE control-plane LLM config
# Copy this file to .env (same dir), fill in your values, and never commit .env.
#   cp .env.template .env
#
# The pipeline reads these via winre/envfile.py on import (env vars win over
# the file, so per-run overrides still work).

# OpenAI-compatible BASE URL (base only, e.g. http://127.0.0.1:11434).
# The client appends /chat/completions itself, ALWAYS — so a FULL
# endpoint URL does not work: it became
# https://host/v1/chat/completions/chat/completions (code audit 2026-09-28).
# Format: URL string
WINRE_LLM_BASE_URL=

# OpenAI-compatible model name (use the model name your provider exposes)
# Format: string
WINRE_LLM_MODEL=
# Optional role pins (RevAI handoff item 7). Leave blank to use
# WINRE_LLM_MODEL for that role. A pin never moves the other roles.
#   WINRE_LLM_PLANNER_MODEL = the 35-tool ReAct loop (call/token heavy)
#   WINRE_LLM_VERDICT_MODEL = the final judge (verdict + finalize pass)
#WINRE_LLM_PLANNER_MODEL=
#WINRE_LLM_VERDICT_MODEL=

# Reasoning effort (low, medium, high, max) or leave blank if unsupported.
# Format: string
WINRE_LLM_REASONING=

# API key for the above endpoint
# Format: string
WINRE_LLM_API_KEY=

# ── FlareVM (execution plane) ──────────────────────────────────────────────
# Your isolated FlareVM reachable over SSH from this control plane.
# Copy .env.template to .env and fill in YOUR lab values (never commit .env).
FLARE_HOST=
FLARE_USER=FLARE-VM
FLARE_SSH_KEY=
FLARE_SSH_PORT=22

# ── Snapshot gate (optional) ───────────────────────────────────────────────
# observe (advisory) | enforce (blocks execution without a clean marker) | off
# observe/enforce/off. ENFORCE is the code default and the safe one: under
# enforce a single clean restore permits exactly ONE execution, so a run
# that asks for both --dynamic and --agentic-dbg is refused before any
# stage runs. This template used to ship `observe`, which silently
# disabled that guarantee for everyone who followed docs/INSTALL.md
# (code audit 2026-09-28).
WINRE_SNAPSHOT_GATE=enforce
# Hypervisor auto-restore (optional): vmware | vbox, plus VM path + snapshot name
#WINRE_HYPERVISOR=
#WINRE_VM_PATH=
#WINRE_SNAPSHOT=

# VirusTotal HASH-ONLY triage (control plane; only the SHA256 is sent)
WINRE_VT_API_KEY=
